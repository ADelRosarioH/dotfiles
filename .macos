#!/usr/bin/env bash
# macOS setup — Anthony. Run from the repo:  ./.macos
# Safe to re-run. Needs: brew bundle (for dockutil); asks for your password once (sudo). Some changes need a logout to fully apply.
set -u
eval "$(/opt/homebrew/bin/brew shellenv)"
say() { printf '\033[1;34m▸ %s\033[0m\n' "$1"; }

osascript -e 'tell application "System Settings" to quit' 2>/dev/null

# ── Raycast replaces Spotlight (⌘Space) ───────────────────────────
say "Raycast on ⌘Space, Spotlight shortcut off"
# 64 = Show Spotlight search, 65 = Finder search window
for k in 64 65; do
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add $k \
    "<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>1048576</integer></array><key>type</key><string>standard</string></dict></dict>"
done
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null
osascript -e 'tell application "Raycast" to quit' 2>/dev/null; sleep 1
defaults write com.raycast.macos raycastGlobalHotkey -string "Command-49"
osascript -e 'tell application "System Events" to make login item at end with properties {path:"/Applications/Raycast.app", hidden:true}' >/dev/null 2>&1
open -a Raycast

# ── Dock: dev + work apps only ────────────────────────────────────
say "Dock"
"$(dirname "$0")/dock.sh"
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0
defaults write com.apple.dock tilesize -int 44
defaults write com.apple.dock magnification -bool false
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock minimize-to-application -bool true
defaults write com.apple.dock mineffect -string "scale"

# ── Performance ───────────────────────────────────────────────────
say "Snappier animations"
defaults write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool false
defaults write NSGlobalDomain NSWindowResizeTime -float 0.001
defaults write com.apple.dock expose-animation-duration -float 0.1
defaults write com.apple.dock launchanim -bool false
defaults write com.apple.finder DisableAllAnimations -bool true

say "Reduce motion & transparency"
if ! { defaults write com.apple.universalaccess reduceMotion -bool true &&
       defaults write com.apple.universalaccess reduceTransparency -bool true; } 2>/dev/null; then
  echo "  macOS blocked this from Terminal — turn on manually:"
  echo "  System Settings → Accessibility → Display → Reduce motion + Reduce transparency"
fi

say "No .DS_Store on network/USB drives"
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# ── Finder for devs ───────────────────────────────────────────────
say "Finder"
defaults write com.apple.finder AppleShowAllFiles -bool true
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
defaults write com.apple.finder _FXSortFoldersFirst -bool true
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
defaults write com.apple.finder NewWindowTarget -string "PfHm"
chflags nohidden ~/Library

# ── No auto-correct (code-safe typing) ────────────────────────────
say "Auto-correct off"
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

# ── Screenshots ───────────────────────────────────────────────────
say "Screenshots → ~/Screenshots"
mkdir -p "$HOME/Screenshots"
defaults write com.apple.screencapture location -string "$HOME/Screenshots"
defaults write com.apple.screencapture type -string "png"
defaults write com.apple.screencapture disable-shadow -bool true

# ── Dev power-ups (needs your password / Touch ID once) ───────────
say "Touch ID for sudo, higher open-file limit"
sudo -v
if ! grep -qs '^auth.*pam_tid.so' /etc/pam.d/sudo_local; then
  sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template | sudo tee /etc/pam.d/sudo_local >/dev/null && echo "  Touch ID enabled for sudo"
fi
sudo tee /Library/LaunchDaemons/limit.maxfiles.plist >/dev/null <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>limit.maxfiles</string>
  <key>ProgramArguments</key><array>
    <string>launchctl</string><string>limit</string><string>maxfiles</string><string>524288</string><string>524288</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict></plist>
PLIST
sudo chown root:wheel /Library/LaunchDaemons/limit.maxfiles.plist
sudo launchctl bootstrap system /Library/LaunchDaemons/limit.maxfiles.plist 2>/dev/null || sudo launchctl limit maxfiles 524288 524288

say "Spaces stay put, save to disk, expanded dialogs"
defaults write com.apple.dock mru-spaces -bool false
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# ── Trackpad & keyboard ───────────────────────────────────────────
say "Tap to click, three-finger drag, Tab through all controls"
for d in com.apple.AppleMultitouchTrackpad com.apple.driver.AppleBluetoothMultitouch.trackpad; do
  defaults write $d Clicking -bool true
  defaults write $d TrackpadThreeFingerDrag -bool true
  # three-finger swipes move to four fingers so they don't clash with drag
  defaults write $d TrackpadThreeFingerHorizSwipeGesture -int 0
  defaults write $d TrackpadThreeFingerVertSwipeGesture -int 0
  defaults write $d TrackpadFourFingerHorizSwipeGesture -int 2
  defaults write $d TrackpadFourFingerVertSwipeGesture -int 2
done
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2

# ── Menu bar & look ───────────────────────────────────────────────
say "Battery %, dark mode, no Spotlight/Siri icons"
defaults -currentHost write com.apple.controlcenter BatteryShowPercentage -bool true
defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"
osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true' >/dev/null 2>&1
defaults -currentHost write com.apple.Spotlight MenuItemHidden -int 1
defaults write com.apple.Spotlight "NSStatusItem Visible Item-0" -bool false
defaults write com.apple.Siri StatusMenuVisible -bool false

# ── Battery & quiet ───────────────────────────────────────────────
say "Low Power Mode on battery, clean app launches, no Photos pop-up"
sudo pmset -b lowpowermode 1
defaults write NSGlobalDomain NSQuitAlwaysKeepsWindows -bool false
defaults write com.apple.loginwindow TALLogoutSavesState -bool false
defaults -currentHost write com.apple.ImageCapture disableHotPlug -bool true

say "Activity Monitor: all processes by CPU"
defaults write com.apple.ActivityMonitor ShowCategory -int 0
defaults write com.apple.ActivityMonitor SortColumn -string "CPUUsage"
defaults write com.apple.ActivityMonitor SortDirection -int 0
defaults write com.apple.ActivityMonitor IconType -int 5

# ── Security ──────────────────────────────────────────────────────
say "Firewall + stealth, lock on sleep, auto security updates"
FW=/usr/libexec/ApplicationFirewall/socketfilterfw
sudo $FW --setglobalstate on >/dev/null && sudo $FW --setstealthmode on >/dev/null && echo "  firewall on, stealth on"
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false
echo "  Lock on sleep — enter your login password when asked:"
sysadminctl -screenLock immediate -password - 2>&1 | grep -v '^$' | sed 's/^/  /'
if fdesetup status | grep -q "On"; then echo "  FileVault: on"; else
  echo "  ⚠ FileVault is OFF — turn it on: System Settings → Privacy & Security → FileVault"; fi

killall Dock Finder SystemUIServer ControlCenter cfprefsd 2>/dev/null

# ── One manual step ───────────────────────────────────────────────
say "Last step (macOS doesn't allow scripting this): exclude ~/Projects from Spotlight"
echo "  In the window that opens: Search Privacy… → + → choose your Projects folder"
open "x-apple.systempreferences:com.apple.Spotlight-Settings.extension"
printf '\n\033[1;32mDone.\033[0m Log out and back in so ⌘Space and every tweak fully applies.\n'
